
# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymie_dev
# Or use individual connection parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=gymie_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Or use individual connection parameters:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24

# Storage Configuration (Cloudflare R2 / S3-compatible)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=gymie-dev
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://your-public-url.com
STORAGE_PRESIGN_EXPIRY=15

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
