
# Production Environment Variables for Gymie Backend
# Copy this to .env.production and update with your values

# Database (provided by Render.com)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (provided by Upstash.com)
REDIS_URL=redis://default:password@host:port

# JWT Configuration (CRITICAL: Change this!)
JWT_SECRET=your-very-secure-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRATION=24

# Server Configuration
PORT=8080
ENVIRONMENT=production

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Optional: File Storage (if using Cloudflare R2 or S3)
# STORAGE_ENDPOINT=https://...
# STORAGE_ACCESS_KEY=...
# STORAGE_SECRET_KEY=...
# STORAGE_BUCKET=gymie-production
