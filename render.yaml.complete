
# Complete Render deployment configuration for Gymie Backend
# This includes ALL required environment variables
# 
# To use:
# 1. Rename to render.yaml
# 2. Fill in the values marked with YOUR_*
# 3. Deploy with: render deploy

databases:
  - name: gymie-db
    plan: free
    databaseName: gymie
    user: gymie_user
    region: singapore
    ipAllowList: []

services:
  - type: web
    name: gymie-api
    runtime: docker
    region: singapore
    plan: free
    branch: main
    rootDir: backend
    dockerfilePath: ./Dockerfile
    
    envVars:
      # Server Configuration
      - key: PORT
        value: 8080
      - key: ENVIRONMENT
        value: production

      # Database (Auto-configured)
      - key: DATABASE_URL
        fromDatabase:
          name: gymie-db
          property: connectionString

      # Redis (Get from Upstash dashboard)
      - key: REDIS_URL
        sync: false  # MANUAL: Add from Upstash: redis://default:PASSWORD@HOST.upstash.io:PORT

      # JWT Configuration
      - key: JWT_SECRET
        generateValue: true  # Auto-generates secure secret
      - key: JWT_EXPIRATION
        value: 24

      # Email Configuration - OPTION 1: Gmail (Development/Testing)
      # Uncomment these if using Gmail:
      # - key: SMTP_HOST
      #   value: smtp.gmail.com
      # - key: SMTP_PORT
      #   value: 587
      # - key: SMTP_USERNAME
      #   value: YOUR_GMAIL@gmail.com
      # - key: SMTP_PASSWORD
      #   sync: false  # MANUAL: Add Gmail App Password
      # - key: FROM_EMAIL
      #   value: YOUR_GMAIL@gmail.com
      # - key: FROM_NAME
      #   value: Gymie

      # Email Configuration - OPTION 2: SendGrid (Production - Recommended)
      # Uncomment these if using SendGrid:
      - key: SMTP_HOST
        value: smtp.sendgrid.net
      - key: SMTP_PORT
        value: 587
      - key: SMTP_USERNAME
        value: apikey  # Literal "apikey" - not your actual username
      - key: SMTP_PASSWORD
        sync: false  # MANUAL: Add SendGrid API Key
      - key: FROM_EMAIL
        value: noreply@gymie.fit  # Or your verified sender email
      - key: FROM_NAME
        value: Gymie

      # Frontend URL (for email verification links)
      - key: FRONTEND_URL
        value: https://gymie.fit  # CHANGE TO YOUR ACTUAL DOMAIN

      # Storage Configuration (Cloudflare R2)
      # Required for progress photos
      - key: STORAGE_ENDPOINT
        sync: false  # MANUAL: https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
      - key: STORAGE_ACCESS_KEY
        sync: false  # MANUAL: Get from Cloudflare R2
      - key: STORAGE_SECRET_KEY
        sync: false  # MANUAL: Get from Cloudflare R2
      - key: STORAGE_BUCKET
        value: gymie-production
      - key: STORAGE_REGION
        value: auto
      - key: STORAGE_PUBLIC_URL
        sync: false  # MANUAL: https://YOUR-BUCKET.YOUR-DOMAIN.com
      - key: STORAGE_PRESIGN_EXPIRY
        value: 15

      # Rate Limiting
      - key: RATE_LIMIT_ENABLED
        value: "true"
      - key: RATE_LIMIT_REQUESTS
        value: "100"
      - key: RATE_LIMIT_WINDOW
        value: "60"

      # CORS Configuration
      - key: CORS_ALLOWED_ORIGINS
        value: "*"  # Change to specific domain in production: https://gymie.fit

    # Health check
    healthCheckPath: /health
    
    # Auto-deploy on push to main
    autoDeploy: true

# Notes:
# - Variables marked "sync: false" must be added manually in Render dashboard
# - generateValue: true creates a random secure value automatically
# - fromDatabase automatically pulls connection string from the database
